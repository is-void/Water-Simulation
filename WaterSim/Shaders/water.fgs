#version 460 core

struct Material {
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
    float shininess;
}; 

in vec3 FragPos;

out vec4 FragColor;

uniform vec3 camPos;
uniform vec3 lightDir;
uniform vec3 lightColor;

uniform mat4 model;

uniform Material material;
uniform samplerCube reflectionMap;
uniform samplerCube refractionMap;

float calculateTransparency();
vec3 calculateLighting(float frensel);
float distortionIntensity = 0.05;
vec3 viewDir;
vec3 normal;

void main()
{
    vec3 dx = dFdx(FragPos);
    vec3 dy = dFdy(FragPos);
    mat3 normalMatrix = transpose(inverse(mat3(model)));
    normal = normalize(normalMatrix * normalize(cross(dx, dy)));
    viewDir = normalize(camPos - FragPos);

    vec3 color = calculateLighting(calculateTransparency());
	FragColor = vec4(color.x, color.y, color.z, 1.0);
}

float calculateTransparency()
{

    float r0 = 0.02;
    float dotProd = clamp(dot(normal, viewDir), 0.0, 1.0);
   

    float frensel = r0 + (1  - r0) * pow(1 - dotProd, 5);

    float transparency = clamp(frensel, 0.1, 0.9);
    return transparency;
}

vec3 calculateLighting(float frensel)
{
    vec3 ambient = lightColor * material.ambient;
  	
    // diffuse 
    float diff = max(dot(normal, -lightDir), 0.0);
    vec3 diffuse = lightColor * (diff * material.diffuse);
    
    // specular
    vec3 reflectDir = reflect(-lightDir, normal);  
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = lightColor * (spec * material.specular);  
        
    vec3 result = ambient + diffuse + specular;

    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 mutedNormal = mix(normal, up, distortionIntensity);
    vec3 I = normalize(FragPos - camPos);

    vec3 reflectVec = reflect(I, normal);
    vec3 refractVec = refract(I, mutedNormal, 1.0);
    vec3 refractColor = texture(refractionMap, refractVec).rgb;
    vec3 reflectColor = texture(reflectionMap, reflectVec).rgb;


    return mix(refractColor, result+ reflectColor, frensel);

}
